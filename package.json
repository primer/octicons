{
  "name": "@primer/octicons",
  "version": "19.32.0",
  "private": true,
  "workspaces": [
    "lib/octicons_node",
    "lib/octicons_react",
    "lib/octicons_styled"
  ],
  "publishConfig": {
    "registry": "no registry, don't publish from this package.json."
  },
  "scripts": {
    "build": "script/build.js --input icons/**/*.svg --output lib/build/data.json --svg-output lib/build/svg",
    "clean": "npm run clean --workspaces --if-present && rimraf lib/build",
    "changeset:version": "changeset version && script/version lib/octicons_node/package.json",
    "lint": "eslint --cache .",
    "svgo": "svgo icons --config svgo.config.js",
    "test": "vitest",
    "version": "script/version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.4.1",
    "@changesets/cli": "2.17.0",
    "@github/prettier-config": "0.0.6",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/browser": "3.2.7",
    "braces": "3.0.3",
    "cheerio": "1.0.0-rc.3",
    "eslint": "10.8.0",
    "eslint-plugin-github": "6.1.1",
    "execa": "4.0.0",
    "fs-extra": "7.0.1",
    "globals": "17.8.0",
    "globby": "11.0.0",
    "js-yaml": "4.3.0",
    "lodash.merge": "4.6.2",
    "playwright": "1.62.0",
    "prettier": "3.4.1",
    "rimraf": "^6.1.3",
    "svgo": "3.3.4",
    "svgson": "5.2.1",
    "trim-newlines": "3.0.1",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "vitest": "3.2.7",
    "yargs": "15.4.1"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "core-js@2.6.12": true,
    "core-js-pure@3.49.0": true,
    "sharp@0.34.5": true,
    "styled-components@4.4.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
