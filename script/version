#!/bin/bash

set -euo pipefail

PACKAGE_VERSION=$(node -p "require('./lib/octicons_node/package.json').version")

sync_package_version() {
  node - "$1" "$PACKAGE_VERSION" <<'NODE'
const fs = require('fs')

const [path, version] = process.argv.slice(2)
const packageJson = JSON.parse(fs.readFileSync(path, 'utf8'))
packageJson.version = version
fs.writeFileSync(path, `${JSON.stringify(packageJson, null, 2)}\n`)
NODE
}

echo "Versioning Octicons root package"
sync_package_version package.json

node - "$PACKAGE_VERSION" <<'NODE'
const fs = require('fs')

const rootVersion = process.argv[2]
const path = 'package-lock.json'
const packageLock = JSON.parse(fs.readFileSync(path, 'utf8'))

packageLock.version = rootVersion
for (const packagePath of Object.keys(packageLock.packages)) {
  if (packagePath === '' || packagePath.startsWith('lib/') && !packagePath.includes('/node_modules/')) {
    const manifestPath = packagePath === '' ? 'package.json' : `${packagePath}/package.json`
    if (!fs.existsSync(manifestPath)) {
      continue
    }
    const packageJson = JSON.parse(fs.readFileSync(manifestPath, 'utf8'))
    packageLock.packages[packagePath].version = packageJson.version
    for (const dependencyType of ['dependencies', 'devDependencies', 'peerDependencies']) {
      if (packageJson[dependencyType]) {
        packageLock.packages[packagePath][dependencyType] = packageJson[dependencyType]
      } else {
        delete packageLock.packages[packagePath][dependencyType]
      }
    }
  }
}

fs.writeFileSync(path, `${JSON.stringify(packageLock, null, 2)}\n`)
NODE

to_ruby_version() {
  if [[ "$1" == 0.0.0-* ]]; then
    echo "${1/0.0.0-/0.0.0.pre.}"
  else
    echo "${1/-rc/.pre}"
  fi
}

OCTICONS_VERSION=$(node -p "require('./lib/octicons_gem/package.json').version")
OCTICONS_HELPER_VERSION=$(node -p "require('./lib/octicons_helper/package.json').version")
JEKYLL_OCTICONS_VERSION=$(node -p "require('./lib/octicons_jekyll/package.json').version")

OCTICONS_RUBY_VERSION=$(to_ruby_version "$OCTICONS_VERSION")
OCTICONS_HELPER_RUBY_VERSION=$(to_ruby_version "$OCTICONS_HELPER_VERSION")
JEKYLL_OCTICONS_RUBY_VERSION=$(to_ruby_version "$JEKYLL_OCTICONS_VERSION")

echo "Versioning Octicons ruby gem"
bundle exec rake -C lib/octicons_gem version\["$OCTICONS_RUBY_VERSION"\]

echo "Versioning Octicons rails helper gem"
bundle exec rake -C lib/octicons_helper \
  version\["$OCTICONS_HELPER_RUBY_VERSION","$OCTICONS_RUBY_VERSION"\]

echo "Versioning Octicons jekyll plugin gem"
bundle exec rake -C lib/octicons_jekyll \
  version\["$JEKYLL_OCTICONS_RUBY_VERSION","$OCTICONS_RUBY_VERSION"\]

git add package.json package-lock.json lib/
