{
  "name": "@primer/octicons",
  "version": "19.32.0",
  "description": "A scalable set of icons handcrafted with <3 by GitHub.",
  "homepage": "https://primer.style/octicons",
  "author": "GitHub Inc.",
  "license": "MIT",
  "type": "module",
  "style": "dist/index.scss",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./build/*": "./dist/*",
    "./dist/*": "./dist/*",
    "./index.scss": "./dist/index.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": "https://github.com/primer/octicons.git",
  "bugs": {
    "url": "https://github.com/primer/octicons/issues"
  },
  "scripts": {
    "build": "rimraf dist build index.js index.cjs && mkdir dist && cp -r ../build/. ./dist && rolldown -c && cp index.scss dist/index.scss && cp index.scss dist/build.css",
    "clean": "rimraf dist build index.js index.cjs",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "GitHub",
    "icons",
    "svg",
    "octicons"
  ],
  "devDependencies": {
    "@github/prettier-config": "0.0.4",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.1"
  }
}
