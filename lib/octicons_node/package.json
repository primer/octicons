{
  "name": "@primer/octicons",
  "version": "19.32.0",
  "description": "A scalable set of icons handcrafted with <3 by GitHub.",
  "homepage": "https://primer.style/octicons",
  "author": "GitHub Inc.",
  "license": "MIT",
  "type": "module",
  "style": "index.scss",
  "main": "index.cjs",
  "module": "index.js",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./build/*": "./build/*",
    "./index.scss": "./index.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.scss",
    "build"
  ],
  "repository": "https://github.com/primer/octicons.git",
  "bugs": {
    "url": "https://github.com/primer/octicons/issues"
  },
  "scripts": {
    "build": "rm -f index.js index.cjs && cp -r ../build/. ./build && rolldown -c && cp index.scss ./build/build.css",
    "clean": "rimraf build",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "GitHub",
    "icons",
    "svg",
    "octicons"
  ],
  "devDependencies": {
    "@github/prettier-config": "0.0.4",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.1"
  }
}
